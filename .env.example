# codego-api runtime
CONTROL_PORT=3000
GATEWAY_PORT=3001
NODE_TYPE=master
TZ=Asia/Shanghai

# Database
SQL_DSN=postgresql://codegoapi:replace-with-a-strong-password@127.0.0.1:5432/codegoapi
# LOG_SQL_DSN=postgresql://codegoapi:replace-with-a-strong-password@127.0.0.1:5432/codegoapi_logs
# SQLITE_PATH=./codego-api.db
POSTGRES_USER=codegoapi
POSTGRES_PASSWORD=replace-with-a-strong-password
DEV_POSTGRES_PASSWORD=change-me-in-development
POSTGRES_DB=codegoapi

# Cache and workers
REDIS_CONN_STRING=redis://127.0.0.1:6379/0
TEMPORAL_HOSTPORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Session and public frontend
SESSION_SECRET=replace-with-a-random-secret
# SESSION_COOKIE_SECURE=true
# FRONTEND_BASE_URL=https://frontend.example.com

# Optional runtime controls
# DEBUG=false
# ENABLE_PPROF=false
# ERROR_LOG_ENABLED=true
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# TRUSTED_REDIRECT_DOMAINS=example.com
# RELAY_TIMEOUT=0
# STREAMING_TIMEOUT=300
# TLS_INSECURE_SKIP_VERIFY=false
# GENERATE_DEFAULT_TOKEN=false

# Optional observability
# PYROSCOPE_URL=http://127.0.0.1:4040
# PYROSCOPE_APP_NAME=codego-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
